{
  "name": "mlpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:native": "swiftc -module-cache-path .swift-test-cache ios/App/App/WAVRecovery.swift tests/WAVRecoveryTests.swift -o .wav-recovery-tests && ./.wav-recovery-tests",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "voice:dev": "node --env-file-if-exists=.env.local services/voice-server.mjs"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "lucide-react": "^0.469.0",
    "zod": "^3.24.1",
    "dexie": "^4.0.11",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "tailwindcss": "^3.4.4",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19",
    "tsx": "^4.21.0",
    "fake-indexeddb": "^6.0.0",
    "serve": "^14.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
