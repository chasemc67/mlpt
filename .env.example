# Local database and device speech need no credentials.
# Optional AI Gateway server credential (never prefix with NEXT_PUBLIC_).
AI_GATEWAY_API_KEY=
# Address compiled into the web/mobile client. iPad needs a reachable HTTPS voice service.
NEXT_PUBLIC_VOICE_URL=http://127.0.0.1:3001
VOICE_PORT=3001
VOICE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost
